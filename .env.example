# Copy to .env.local and fill in. Never commit real values. See docs/DEPLOYMENT.md for where each comes from.

# --- Public (safe to be seen by browsers) ---
# Supabase dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard > Project Settings > API > "anon" / "publishable" key. Has no database access by itself.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The address of this site. Production: https://menu.taprizz.in
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- SERVER ONLY (secrets: never put these in NEXT_PUBLIC_*, never send to the browser) ---
# Supabase dashboard > Project Settings > API > "service_role" key. Full power: keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the guest's table-session cookie. Generate: openssl rand -base64 48
GUEST_COOKIE_SECRET=
# Salt for hashing guest IP addresses before storing. Generate: openssl rand -base64 24
IP_HASH_SALT=
# Padharosaa hotel concierge only (not needed for Menu Lite). Encrypts guest mobile numbers. Generate: openssl rand -base64 32
PADHAROSAA_DATA_KEY=
# Optional: Sentry error reporting DSN
SENTRY_DSN=
# debug | info | warn | error
LOG_LEVEL=info

# --- Padharosaa (not needed for Menu Lite) ---
# openssl rand -base64 32   (shared secret for /api/padharosaa/v1/cron/notify)
CRON_SECRET=
# Buffet alerts on guests' phones (Web Push). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# WhatsApp Business Cloud API (optional; alerts wait in the outbox until these are set)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_HELP_TEMPLATE=padharosaa_help_alert
WHATSAPP_TEMPLATE_LANG=en

# Optional: AI wording for the Jaipur guide (drafts only; the manager reviews). Any OpenAI-compatible service, including free tiers:
#   Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash   (key from aistudio.google.com)
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1                           AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
